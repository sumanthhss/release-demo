<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.3</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>release-demo</artifactId>
	<version>0.0.2-SNAPSHOT</version>
	<name>release-demo</name>
	<description>Demo project for Spring Boot</description>
	<url />
	<licenses>
		<license />
	</licenses>
	<developers>
		<developer />
	</developers>
	<scm>
  <connection>scm:git:https://github.com/sumanthhss/release-demo.git</connection>
  <developerConnection>scm:git:https://github.com/sumanthhss/release-demo.git</developerConnection>
  <tag>release-demo-0.0.1</tag>
   </scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
	<plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-release-plugin</artifactId>
      <version>3.0.1</version>
      <configuration>
        <!-- Tag format for SCM -->
        <tagNameFormat>@{project.artifactId}-@{project.version}</tagNameFormat>
        <!-- Push changes automatically -->
        <pushChanges>true</pushChanges>
        <!-- Arguments passed during perform phase -->
        <arguments>-DskipTests</arguments>
        <!-- SCM commit message prefix -->
        <scmCommentPrefix>[release]</scmCommentPrefix>
      </configuration>
    </plugin>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-compiler-plugin</artifactId>
      <configuration>
        <release>21</release>
      </configuration>
    </plugin>
		</plugins>
	</build>
	<distributionManagement>

  <!-- Repository for release versions -->
  <repository>
    <id>local-releases</id>
    <name>Company Release Repository</name>
    <url>file:///home/sumanth/local-maven-repo/releases/</url>
  </repository>

  <!-- Repository for snapshot versions -->
  <snapshotRepository>
    <id>local-snapshots</id>
    <name>Company Snapshot Repository</name>
    <url>file:///home/sumanth/local-maven-repo/snapshots</url>
  </snapshotRepository>

</distributionManagement>

</project>
